        "role": { "type": "string", "enum": ["main_admin", "accountant", "teacher", "director"], "maxLength": 24 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "uid", "email", "displayName", "schoolId", "schoolName", "role", "createdAt", "updatedAt"]
    },
